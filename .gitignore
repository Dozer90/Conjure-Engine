# Build outputs
/build/
/out/
/install/
/export/
*.ninja_log
CMakeUserPresets.json

# Dependency caches
/third_party/_deps/

# Per-project editor and import state: <project>/.conjure holds the import cache, editor_layout.ini, ai_port, the
# token files ai_token and ai_token_inspect, and the audit log ai_audit.log / ai_audit.1.log
# (docs/design/04_editor.md D12, D23, D25, D26); never versioned, the token files least of all. The .meta sidecars
# are deliberately not ignored: tests and CI copy a fixture project before opening it, so a .meta file appearing in
# the tree is a warning to heed.
**/.conjure/

# Managed (.NET) build outputs
**/bin/
**/obj/
*.nupkg

# Asset packs supplied by the project owner live here but are not part of the repository
# (several GB; see samples/assets/README.md for the expected layout and licences)
/samples/assets/*
!/samples/assets/README.md

# Test assets downloaded by tools/download_test_assets.py
/samples/**/assets/downloaded/
/tests/.downloaded/
/tests/.assets_ready

# Compiled shaders
*.dxil
*.spv
*.cso

# Python
__pycache__/
*.pyc

# IDE / editor
/.vs/
/.vscode/
/.idea/
*.user
*.suo
*.swp
*~
.DS_Store
Thumbs.db

# Logs and crash dumps
*.log
*.dmp
/logs/

# Documentation toolchain
/.venv-docs/
/site/
