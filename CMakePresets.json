{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    { "name": "windows-msvc-debug", "displayName": "Windows MSVC Debug", "inherits": "windows-msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "windows-msvc-dev", "displayName": "Windows MSVC Development", "inherits": "windows-msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Development" } },
    { "name": "windows-msvc-dist", "displayName": "Windows MSVC Distribution", "inherits": "windows-msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Distribution" } },
    { "name": "windows-msvc-asan", "displayName": "Windows MSVC Debug + ASan", "inherits": "windows-msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CONJURE_ENABLE_ASAN": "ON" } },
    {
      "name": "windows-vs",
      "displayName": "Windows Visual Studio (multi-config)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },

    {
      "name": "linux-gcc",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-clang",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    { "name": "linux-gcc-debug", "displayName": "Linux GCC Debug", "inherits": "linux-gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-gcc-dev", "displayName": "Linux GCC Development", "inherits": "linux-gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Development" } },
    { "name": "linux-gcc-dist", "displayName": "Linux GCC Distribution", "inherits": "linux-gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Distribution" } },
    { "name": "linux-clang-debug", "displayName": "Linux Clang Debug", "inherits": "linux-clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-clang-sanitize", "displayName": "Linux Clang Debug + ASan/UBSan", "inherits": "linux-clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CONJURE_ENABLE_ASAN": "ON", "CONJURE_ENABLE_UBSAN": "ON" } },
    { "name": "linux-clang-tsan", "displayName": "Linux Clang Debug + TSan (scripting off)", "inherits": "linux-clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CONJURE_ENABLE_TSAN": "ON", "CONJURE_WITH_SCRIPTING": "OFF" } },

    {
      "name": "macos",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    { "name": "macos-debug", "displayName": "macOS Debug", "inherits": "macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "macos-dev", "displayName": "macOS Development", "inherits": "macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Development" } },
    { "name": "macos-dist", "displayName": "macOS Distribution", "inherits": "macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Distribution" } }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-dev", "configurePreset": "windows-msvc-dev" },
    { "name": "windows-msvc-dist", "configurePreset": "windows-msvc-dist" },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan" },
    { "name": "windows-vs-debug", "configurePreset": "windows-vs", "configuration": "Debug",
      "displayName": "Windows VS Debug (multi-config: the last configuration built is the one ctest runs)" },
    { "name": "windows-vs-dev", "configurePreset": "windows-vs", "configuration": "Development",
      "displayName": "Windows VS Development (multi-config: the last configuration built is the one ctest runs)" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-dev", "configurePreset": "linux-gcc-dev" },
    { "name": "linux-gcc-dist", "configurePreset": "linux-gcc-dist" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-sanitize", "configurePreset": "linux-clang-sanitize" },
    { "name": "linux-clang-tsan", "configurePreset": "linux-clang-tsan" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-dev", "configurePreset": "macos-dev" },
    { "name": "macos-dist", "configurePreset": "macos-dist" }
  ],
  "testPresets": [
    { "name": "base-test", "hidden": true,
      "output": { "outputOnFailure": true, "verbosity": "default" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false, "jobs": 4 },
      "filter": { "exclude": { "label": "benchmark|golden|downloaded|slow|process" } } },
    { "name": "nightly-test", "hidden": true, "inherits": "base-test",
      "filter": { "exclude": { "label": "benchmark" } } },
    { "name": "windows-msvc-debug", "inherits": "base-test", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-dev", "inherits": "base-test", "configurePreset": "windows-msvc-dev" },
    { "name": "windows-msvc-dist", "inherits": "base-test", "configurePreset": "windows-msvc-dist",
      "displayName": "Windows MSVC Distribution (asserts and TRACE/DEBUG logging compiled out)" },
    { "name": "windows-msvc-asan", "inherits": "base-test", "configurePreset": "windows-msvc-asan" },
    { "name": "windows-vs-debug", "inherits": "base-test", "configurePreset": "windows-vs", "configuration": "Debug",
      "displayName": "Windows VS Debug (multi-config: test discovery reflects the configuration built last)" },
    { "name": "linux-gcc-debug", "inherits": "base-test", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-dev", "inherits": "base-test", "configurePreset": "linux-gcc-dev" },
    { "name": "linux-gcc-dist", "inherits": "base-test", "configurePreset": "linux-gcc-dist",
      "displayName": "Linux GCC Distribution (asserts and TRACE/DEBUG logging compiled out)" },
    { "name": "linux-clang-debug", "inherits": "base-test", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-sanitize", "inherits": "base-test", "configurePreset": "linux-clang-sanitize" },
    { "name": "linux-clang-tsan", "inherits": "nightly-test", "configurePreset": "linux-clang-tsan",
      "filter": { "include": { "label": "core|ecs|scene|engine|integration" }, "exclude": { "label": "benchmark" } } },
    { "name": "windows-msvc-debug-nightly", "inherits": "nightly-test", "configurePreset": "windows-msvc-debug" },
    { "name": "linux-gcc-debug-nightly", "inherits": "nightly-test", "configurePreset": "linux-gcc-debug" },
    { "name": "macos-debug", "inherits": "base-test", "configurePreset": "macos-debug" },
    { "name": "macos-dev", "inherits": "base-test", "configurePreset": "macos-dev" }
  ],
  "workflowPresets": [
    { "name": "windows-msvc-debug", "steps": [
      { "type": "configure", "name": "windows-msvc-debug" },
      { "type": "build", "name": "windows-msvc-debug" },
      { "type": "test", "name": "windows-msvc-debug" } ] },
    { "name": "linux-gcc-debug", "steps": [
      { "type": "configure", "name": "linux-gcc-debug" },
      { "type": "build", "name": "linux-gcc-debug" },
      { "type": "test", "name": "linux-gcc-debug" } ] }
  ]
}
