root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{cmake,txt}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,manifest}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
# A case section whose body is a block keeps the block's braces under the label and its statements one level in
# (the layout of the managed sources); `dotnet format --verify-no-changes` is a blocking CI step (code sweep F784).
csharp_indent_case_contents_when_block = false

[*.{hlsl,hlsli}]
indent_size = 4
