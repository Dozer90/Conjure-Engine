    "cmd": "script.write",
    "args": {
      "path": "GameState.cs",
      "source": "using Conjure;\n\nnamespace Game;\n\n/// <summary>\n/// Grid Sweeper game state: board size, mine count, elapsed time and the win/lose state.\n/// </summary>\npublic sealed class GameState : ScriptBehaviour\n{\n    public int Width = 8;\n    public int Height = 8;\n    public int Mines = 10;\n    public float Elapsed = 0.0f;\n    public string State = \"ready\";\n\n    protected override void OnUpdate(float deltaTime)\n    {\n        if (State == \"playing\")\n        {\n            Elapsed += deltaTime;\n        }\n    }\n}\n"
    }
